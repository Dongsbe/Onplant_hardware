[Unit]
Description=OnPlant robot main command loop
After=onplant-sensor.service

[Service]
Type=simple
EnvironmentFile=%h/.config/onplant/onplant-robot.env
ExecStart=/bin/bash -lc 'cd "$ONPLANT_PROJECT_DIR" && exec "$ONPLANT_PROJECT_DIR/venv/bin/python3" robot_main.py --server "$ONPLANT_SERVER" --robot-id "$ONPLANT_ROBOT_ID" --no-remote'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
