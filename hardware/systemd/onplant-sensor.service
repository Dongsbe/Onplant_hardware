[Unit]
Description=OnPlant sensor sender

[Service]
Type=simple
EnvironmentFile=%h/.config/onplant/onplant-robot.env
ExecStart=/bin/bash -lc 'cd "$ONPLANT_PROJECT_DIR" && exec "$ONPLANT_PROJECT_DIR/venv/bin/python3" sensor_sender.py --server "$ONPLANT_SERVER" --robot-id "$ONPLANT_ROBOT_ID" --bus "${ONPLANT_SENSOR_BUS:-3}" --interval "${ONPLANT_SENSOR_INTERVAL:-0.5}" --server-interval "${ONPLANT_SERVER_INTERVAL:-5}" --lux-mode "${ONPLANT_LUX_MODE:-real}" --dht-mode "${ONPLANT_DHT_MODE:-real}" --soil-mode "${ONPLANT_SOIL_MODE:-real}" --dht-pin "${ONPLANT_DHT_PIN:-D27}" --dht-power-gpio "${ONPLANT_DHT_POWER_GPIO:-17}" --dht-power-settle "${ONPLANT_DHT_POWER_SETTLE:-5}" --soil-channel "${ONPLANT_SOIL_CHANNEL:-0}"'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
