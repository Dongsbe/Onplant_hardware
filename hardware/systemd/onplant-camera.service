[Unit]
Description=OnPlant USB camera sender
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/onplant/onplant-robot.env
ExecStart=/bin/bash -lc 'cd "$ONPLANT_PROJECT_DIR" && exec "$ONPLANT_PROJECT_DIR/venv/bin/python3" usb_camera_sender.py --server "$ONPLANT_SERVER" --robot-id "$ONPLANT_ROBOT_ID" --device "${ONPLANT_CAMERA_DEVICE:-/dev/video0}" --width "${ONPLANT_CAMERA_WIDTH:-960}" --height "${ONPLANT_CAMERA_HEIGHT:-540}" --interval "${ONPLANT_CAMERA_INTERVAL:-0.2}"'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
