[Unit]
Description=OnPlant 5-inch display kiosk
After=graphical-session.target onplant-sensor.service

[Service]
Type=simple
EnvironmentFile=%h/.config/onplant/onplant-robot.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/bin/bash -lc 'cd "$ONPLANT_PROJECT_DIR" && exec "$ONPLANT_PROJECT_DIR/venv/bin/python3" "$ONPLANT_PROJECT_DIR/hardware/front_display_app.py" --server "$ONPLANT_SERVER" --robot-id "$ONPLANT_ROBOT_ID"'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
