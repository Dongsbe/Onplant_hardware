ONPLANT_SERVER=http://192.168.100.6:5050
ONPLANT_ROBOT_ID=raspbot-a
ONPLANT_PROJECT_DIR=/home/ai/onplant_robot

ONPLANT_SENSOR_BUS=3
ONPLANT_SENSOR_INTERVAL=0.5
ONPLANT_SERVER_INTERVAL=5
ONPLANT_USE_SENSOR_CACHE=1
ONPLANT_SENSOR_CACHE_MAX_AGE=10

ONPLANT_LUX_MODE=real
ONPLANT_DHT_MODE=real
ONPLANT_SOIL_MODE=real
ONPLANT_DUMMY_SOIL=0

ONPLANT_DHT_PIN=D27
ONPLANT_DHT_POWER_GPIO=17
ONPLANT_DHT_POWER_SETTLE=5
ONPLANT_DHT_READ_INTERVAL=3

ONPLANT_SOIL_CHANNEL=0
ONPLANT_SOIL_DRY_VOLTS=2.0
ONPLANT_SOIL_WET_VOLTS=1.2

ONPLANT_MIC_DEVICE=plughw:CARD=WEBCAM,DEV=0
ONPLANT_SPEAKER_DEVICE=plughw:CARD=UACDemoV10,DEV=0
ONPLANT_MIC_NORMALIZE=1
ONPLANT_MIC_TARGET_PEAK=12000
ONPLANT_MIC_MAX_GAIN=10.0
ONPLANT_MIC_MIN_PEAK=500
ONPLANT_WAKE_NAME=동스비
ONPLANT_WAKE_SECONDS=3
ONPLANT_VOICE_SECONDS=6
ONPLANT_WAKE_CONFIDENCE=0.50
ONPLANT_WAKE_SIMILARITY=0.75
ONPLANT_WAKE_MAX_LENGTH_DIFF=1
ONPLANT_COMMAND_CONFIDENCE=0.30
ONPLANT_VOSK_MODEL=/home/ai/onplant_robot/models/vosk-model-small-ko-0.22
ONPLANT_TTS_VOICE=ko-KR-InJoonNeural
ONPLANT_TTS_RATE=+0%
ONPLANT_TTS_PITCH=+0Hz
ONPLANT_TTS_VOLUME=+0%
ONPLANT_TTS_EDGE_RETRIES=2
ONPLANT_TTS_ESPEAK_FALLBACK=0
ONPLANT_VOICE_CACHE_DIR=/home/ai/.cache/onplant-voice
ONPLANT_TTS_LOCK_FILE=/tmp/onplant-tts.lock

ONPLANT_LOCAL_COMMAND_FILE=/tmp/onplant-local-commands.jsonl
ONPLANT_SENSOR_CACHE_FILE=/tmp/onplant-latest-sensor.json
ONPLANT_DISPLAY_STATE_FILE=/tmp/onplant-display-state.json
ONPLANT_RUNTIME_STATE_FILE=/tmp/onplant-robot-runtime.json
ONPLANT_COMMAND_TIMEOUT=2.0

# Front display
ONPLANT_DISPLAY_HOST=127.0.0.1
ONPLANT_DISPLAY_PORT=8765
ONPLANT_DISPLAY_POLL=2.0
ONPLANT_DISPLAY_WIDTH=1024
ONPLANT_DISPLAY_HEIGHT=600
ONPLANT_CONTROL_SETTINGS_FILE=/home/ai/.config/onplant/display-controls.json

ONPLANT_TARGET_LUX_MIN=800
ONPLANT_TARGET_LUX_MAX=900
ONPLANT_TARGET_LUX=850
ONPLANT_LIGHT_FOUND_MARGIN=50
ONPLANT_RETURN_STOP_MARGIN=50
ONPLANT_LIGHT_SEEK_SECONDS=20

# Motor speeds
ONPLANT_DRIVE_SPEED=26
ONPLANT_DRIVE_MIN_SPEED=24
ONPLANT_FORWARD_SPEED=28
ONPLANT_TURN_SPEED=90
ONPLANT_BACKWARD_SPEED=22

# Dead-reckoning calibration
# Measured at TURN_SPEED=90: ~105deg/0.6s.
# Use 175deg/s as the calibrated angular rate.
ONPLANT_POSE_LINEAR_MM_PER_SEC=90
ONPLANT_POSE_TURN_DEG_PER_SEC=175
ONPLANT_POSE_UPDATE_MAX_DT=0.50
ONPLANT_BLOCKED_GRID_MM=100
ONPLANT_LIDAR_TO_FRONT_AXLE=25
ONPLANT_LIDAR_TO_LEFT_OUTER=80
ONPLANT_LIDAR_TO_RIGHT_OUTER=80

# Free exploration
ONPLANT_EXPLORE_SECONDS=50
ONPLANT_EXPLORE_BRANCH_ENABLED=1
ONPLANT_EXPLORE_BRANCH_DELAY_SECONDS=4.0
ONPLANT_EXPLORE_BRANCH_MIN_INTERVAL=3.0
ONPLANT_EXPLORE_BRANCH_MAX_INTERVAL=7.0
ONPLANT_EXPLORE_BRANCH_OPEN_MM=450
ONPLANT_EXPLORE_BRANCH_SECONDS=0.10
ONPLANT_EXPLORE_EDGE_BIAS_X=220
ONPLANT_EXPLORE_POST_ESCAPE_FORWARD_SECONDS=0.8
ONPLANT_EXPLORE_NUDGE_INTERVAL=2.5
ONPLANT_EXPLORE_NUDGE_SECONDS=0.09

# Short avoidance / backup pulses
ONPLANT_TURN_PULSE_SECONDS=0.12
ONPLANT_BACKUP_SECONDS=0.30
ONPLANT_ESCAPE_TURN_SECONDS=0.42
ONPLANT_DEADEND_BACKUP_SECONDS=0.65

# Coordinate return
ONPLANT_RETURN_MAX_SECONDS=20.0
ONPLANT_RETURN_HEADING_TOLERANCE_DEGREES=22
ONPLANT_RETURN_TURN_MIN_SECONDS=0.08
ONPLANT_RETURN_DETOUR_DISTANCE_MM=350
ONPLANT_RETURN_DETOUR_STOP_MARGIN=90
ONPLANT_RETURN_DETOUR_MAX_SECONDS=5.0
ONPLANT_RETURN_PROGRESS_MIN_MM=80
ONPLANT_RETURN_STALL_SECONDS=5.0

# Committed corner escape
ONPLANT_ESCAPE_TURN_DEGREES=75
ONPLANT_ESCAPE_TURN_TOLERANCE_DEGREES=7
ONPLANT_ESCAPE_TURN_MAX_SECONDS=0.50
ONPLANT_ESCAPE_SIDE_BLOCK_MM=260
ONPLANT_CORNER_BACKUP_SIDE_SCORE_MM=400
ONPLANT_ESCAPE_REPEAT_WINDOW_SECONDS=5.0
ONPLANT_ESCAPE_DIRECTION_LOCK_SECONDS=4.0
ONPLANT_ESCAPE_SAME_TURN_BACKUP_LIMIT=1

# Start-area / door guard
ONPLANT_DOOR_GUARD_ENABLED=1
ONPLANT_DOOR_HALF_WIDTH_MM=220
ONPLANT_DOOR_EXIT_Y_MM=-20
ONPLANT_DOOR_PREDICT_SECONDS=0.55

# LiDAR collision thresholds
ONPLANT_LIDAR_SAFETY_MARGIN=20
ONPLANT_FRONT_WARN_MM=260
ONPLANT_FRONT_DANGER_MM=140
ONPLANT_FRONT_EMERGENCY_MM=70
ONPLANT_FRONT_CLEAR_MM=330
ONPLANT_LIDAR_POINT_LIMIT=3
ONPLANT_THIN_POINT_MM=120

ONPLANT_BACKWARD_WARN_MM=120
ONPLANT_BACKWARD_WIDTH_MM=80
ONPLANT_REAR_POINT_LIMIT=4

ONPLANT_EXPLORE_PASSAGE_SIDE_LIMIT=320
ONPLANT_PASSAGE_CENTER_DEADBAND_MM=40
ONPLANT_SIDE_TOO_CLOSE_MM=280
ONPLANT_SIDE_CRITICAL_MM=260
ONPLANT_TURN_SPACE_MIN_MM=280

# USB camera sender
ONPLANT_CAMERA_KEY=change-this-camera-key
ONPLANT_ROBOT_API_KEY=change-this-robot-api-key
ONPLANT_CAMERA_DEVICE=/dev/video0
ONPLANT_CAMERA_WIDTH=960
ONPLANT_CAMERA_HEIGHT=540
ONPLANT_CAMERA_INTERVAL=0.2
ONPLANT_CAMERA_TIMEOUT=2.0
ONPLANT_CAMERA_JPEG_QUALITY=80

# Standalone straight-line calibration. Pass --course 285 or --course 325
# at runtime so each course uses its own accumulating CSV by default.
ONPLANT_CALIBRATION_STOP_MM=250
ONPLANT_CALIBRATION_DIRECTION=Y
ONPLANT_CALIBRATION_MAX_SECONDS=60
# ONPLANT_CALIBRATION_COURSE=325
# ONPLANT_CALIBRATION_LOG=/home/ai/onplant_robot/calibration_325.csv
